flowchart TB
  classDef platform fill:#eef4ff,stroke:#355a9a,stroke-width:1px
  classDef external fill:#fff0e6,stroke:#b85c00,stroke-width:1px
  classDef data fill:#eefaf0,stroke:#2f7d32,stroke-width:1px
  classDef ops fill:#f5e6ff,stroke:#5e2f8e,stroke-width:1px

  subgraph Clients
    direction TB
    C1[Customer Web]
    C2[Mobile App]
    C3[Partner API]
    C4[Ops Console]
  end

  subgraph Edge
    direction TB
    E1[Global DNS]
    E2[CDN + WAF]
    E3[API Gateway]
    E4[Rate Limiting + Auth]
  end

  subgraph "Platform Core"
    direction TB
    P1[Identity Service]
    P2[Catalog Service]
    P3[Cart Service]
    P4[Order Service]
    P5[Payment Service]
    P6[Fulfillment Service]
    P7[Pricing Service]
    P8[Notification Service]
  end

  subgraph "Data & Events"
    direction TB
    D1[(Customer Profiles DB)]
    D2[(Orders DB)]
    D3[(Inventory DB)]
    D4[(Payments Ledger)]
    D5[Kafka Event Bus]
    D6[S3 Archive]
    D7[Redis State Store]
    D8[(Analytics Warehouse)]
  end

  subgraph "Workflows"
    direction TB
    W1[Fraud Scoring]
    W2[Policy Engine]
    W3[Route Planner]
    W4[ETA Recommender]
    W5[Invoice Generator]
  end

  subgraph "External Services"
    direction TB
    X1[Map Provider]
    X2[Tax Engine]
    X3[Card Processor]
    X4[SMS/Email Provider]
    X5[Shipping Carrier]
  end

  subgraph "Observability"
    direction TB
    O1[Tracing Collector]
    O2[Audit Service]
    O3[SIEM + Alerting]
  end

  C1 -->|browse & checkout| E1
  C2 -->|track journey| E1
  C3 -->|submit order API| E3
  C4 -->|override & incidents| E4

  E1 --> E2 --> E3 --> E4
  E4 --> P1
  P1 -->|token| P2
  P1 -->|token| P3
  P1 -->|token| P4
  P1 -->|events| O1

  P2 -->|product reads| D1
  P2 -->|cache lookup| D7
  P2 -->|catalog events| D5
  P3 -->|inventory locks| D3
  P3 -->|cart snapshot| D7
  P4 -->|create order| D2
  P4 -->|inventory reservation| D3
  P4 -->|state changes| D5
  P5 -->|authorization & capture| X3
  P5 -->|ledger writes| D4
  P6 -->|pick/pack events| D5
  P6 -->|tracking| X5
  P7 -->|price updates| D2
  P7 -->|geo multipliers| X1
  P8 -->|transaction messages| X4
  P8 -->|delivery notifications| C1

  D5 --> W1
  D5 --> W2
  D5 --> W3
  D5 --> W4
  D5 --> W5

  W1 -->|risk score| P4
  W1 -->|risk score| P5
  W2 -->|policy evaluation| P4
  W3 -->|routing data| X1
  W4 -->|recommendations| P2
  W5 -->|invoice file| D8

  P6 -->|taxable shipment| X2
  X2 -->|tax quote| P6
  P4 -->|audit trail| O2
  D8 -->|dashboard feed| O3
  O1 -->|latency SLOs| O3
  O3 -->|alerts| C4

  D8 --> X4
  O2 -->|evidence export| D8

  C1 -.->|refund / dispute| D2
  C4 -.->|manual compensations| W5
  C3 -.->|reconciliation| D8
  W3 -->|dispatch ETA| C2
  W4 -->|campaign recommendations| P2

  class C1,C2,C3,C4 external
  class E1,E2,E3,E4 platform
  class P1,P2,P3,P4,P5,P6,P7,P8 platform
  class D1,D2,D3,D4,D5,D6,D7,D8 data
  class W1,W2,W3,W4,W5 ops
  class X1,X2,X3,X4,X5 external
  class O1,O2,O3 ops
